<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <Style TargetType="Window">
        <Setter Property="Background"
                Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="FontFamily"
                Value="Segoe UI"/>
        <Setter Property="FontSize"
                Value="13"/>
        <Setter Property="Foreground"
                Value="{StaticResource TextBrush}"/>
        <Setter Property="UseLayoutRounding"
                Value="True"/>
        <Setter Property="SnapsToDevicePixels"
                Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode"
                Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode"
                Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"
                Value="Auto"/>
        <Setter Property="RenderOptions.BitmapScalingMode"
                Value="HighQuality"/>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background"
                Value="{StaticResource PanelAltBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushStrong}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="Foreground"
                Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="Padding"
                Value="8 5"/>
        <Setter Property="HasDropShadow"
                Value="True"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground"
                Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="SnapsToDevicePixels"
                Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode"
                Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode"
                Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"
                Value="Auto"/>
    </Style>

    <Style x:Key="PackIconStyle"
           TargetType="{x:Type iconPacks:PackIconMaterial}">
        <Setter Property="Width"
                Value="16"/>
        <Setter Property="Height"
                Value="16"/>
        <Setter Property="Foreground"
                Value="{StaticResource TextBrush}"/>
        <Setter Property="VerticalAlignment"
                Value="Center"/>
        <Setter Property="HorizontalAlignment"
                Value="Center"/>
        <Setter Property="SnapsToDevicePixels"
                Value="True"/>
        <Setter Property="UseLayoutRounding"
                Value="True"/>
    </Style>

    <Style x:Key="TitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize"
                Value="15"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
    </Style>

    <Style x:Key="SectionTitleTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize"
                Value="14"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
    </Style>

    <Style x:Key="TinyMutedTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize"
                Value="11"/>
        <Setter Property="Foreground"
                Value="{StaticResource MutedTextBrush}"/>
    </Style>

    <Style x:Key="SmallMutedTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize"
                Value="12"/>
        <Setter Property="Foreground"
                Value="{StaticResource MutedTextBrush}"/>
    </Style>

    <Style x:Key="MonoTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily"
                Value="Consolas"/>
        <Setter Property="FontSize"
                Value="12"/>
    </Style>

    <Style x:Key="PagePanelStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource CardPanelBrush}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderBrushSoft}"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="CornerRadius"
                Value="8"/>
        <Setter Property="Padding"
                Value="12"/>
    </Style>

    <Style x:Key="CardBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource PagePanelStyle}"/>

    <Style x:Key="SoftCardBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource PagePanelStyle}">
        <Setter Property="Background"
                Value="{StaticResource CardPanelBrush}"/>
    </Style>

    <Style x:Key="MetricCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource PagePanelStyle}">
        <Setter Property="Background"
                Value="{StaticResource MetricPanelBrush}"/>
        <Setter Property="MinHeight"
                Value="104"/>
        <Setter Property="Padding"
                Value="12"/>
    </Style>

    <Style x:Key="IconBadgeStyle"
           TargetType="Border">
        <Setter Property="Width"
                Value="32"/>
        <Setter Property="Height"
                Value="32"/>
        <Setter Property="CornerRadius"
                Value="8"/>
        <Setter Property="Background"
                Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush"
                Value="#164A8A"/>
        <Setter Property="BorderThickness"
                Value="1"/>
        <Setter Property="SnapsToDevicePixels"
                Value="True"/>
        <Setter Property="UseLayoutRounding"
                Value="True"/>
    </Style>

    <Style x:Key="VectorIconStyle"
           TargetType="Path">
        <Setter Property="Width"
                Value="16"/>
        <Setter Property="Height"
                Value="16"/>
        <Setter Property="Stretch"
                Value="Uniform"/>
        <Setter Property="Fill"
                Value="{StaticResource TextBrush}"/>
        <Setter Property="SnapsToDevicePixels"
                Value="True"/>
    </Style>
    <Style x:Key="ModernTabControlStyle"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#07111B"
                                BorderBrush="#102235"
                                BorderThickness="0 0 0 1"
                                Padding="10 0">
                            <TabPanel IsItemsHost="True"
                                      Background="Transparent"
                                      Margin="0"
                                      VerticalAlignment="Bottom"/>
                        </Border>

                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernTabItemStyle"
           TargetType="{x:Type TabItem}">
        <Setter Property="Foreground"
                Value="{StaticResource MutedTextBrush}"/>
        <Setter Property="FontWeight"
                Value="SemiBold"/>
        <Setter Property="FontSize"
                Value="13"/>
        <Setter Property="Padding"
                Value="10 0"/>
        <Setter Property="Margin"
                Value="0 0 6 0"/>
        <Setter Property="MinHeight"
                Value="36"/>
        <Setter Property="Background"
                Value="Transparent"/>
        <Setter Property="BorderBrush"
                Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid UseLayoutRounding="True"
                          SnapsToDevicePixels="True">
                        <Border x:Name="HoverBackground"
                                Height="32"
                                CornerRadius="10"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="ActiveLine"
                                Height="2"
                                CornerRadius="1"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Bottom"
                                Margin="12 0"
                                Opacity="0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextBrush}"/>
                        </Trigger>

                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="ActiveLine"
                                    Property="Opacity"
                                    Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
