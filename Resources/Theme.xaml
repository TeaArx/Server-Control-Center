<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#0D131A</Color>
    <Color x:Key="PanelBackgroundColor">#111A23</Color>
    <Color x:Key="PanelAltColor">#182430</Color>
    <Color x:Key="SubtleBackgroundColor">#1D2B38</Color>
    <Color x:Key="BorderColor">#283847</Color>
    <Color x:Key="StrongBorderColor">#354A5D</Color>
    <Color x:Key="TextColor">#EDF2F6</Color>
    <Color x:Key="MutedTextColor">#9BA9B6</Color>
    <Color x:Key="AccentColor">#25CDBB</Color>
    <Color x:Key="AccentHoverColor">#45DBCA</Color>
    <Color x:Key="AccentSoftColor">#173D3C</Color>
    <Color x:Key="ButtonHoverColor">#22313F</Color>
    <Color x:Key="ButtonPressedColor">#2A3B49</Color>
    <Color x:Key="TableRowColor">#121C25</Color>
    <Color x:Key="TableAltRowColor">#15202A</Color>
    <Color x:Key="TableHoverColor">#1D303B</Color>
    <Color x:Key="TableSelectedColor">#1B4546</Color>
    <Color x:Key="PurpleColor">#A78BCE</Color>
    <Color x:Key="DangerColor">#E8767F</Color>
    <Color x:Key="WarningColor">#DDB66F</Color>
    <Color x:Key="SuccessColor">#59C99A</Color>
    <Color x:Key="ConsoleBackgroundColor">#0A1117</Color>
    <Color x:Key="ConsoleTextColor">#CAD4DC</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush"
                     Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelAltBrush"
                     Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="SubtleBackgroundBrush"
                     Color="{StaticResource SubtleBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrushSoft"
                     Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderBrushStrong"
                     Color="{StaticResource StrongBorderColor}"/>
    <SolidColorBrush x:Key="TextBrush"
                     Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush"
                     Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush"
                     Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush"
                     Color="{StaticResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="ButtonPressedBrush"
                     Color="{StaticResource ButtonPressedColor}"/>
    <SolidColorBrush x:Key="TableRowBrush"
                     Color="{StaticResource TableRowColor}"/>
    <SolidColorBrush x:Key="TableAltRowBrush"
                     Color="{StaticResource TableAltRowColor}"/>
    <SolidColorBrush x:Key="TableHoverBrush"
                     Color="{StaticResource TableHoverColor}"/>
    <SolidColorBrush x:Key="TableSelectedBrush"
                     Color="{StaticResource TableSelectedColor}"/>
    <SolidColorBrush x:Key="PurpleBrush"
                     Color="{StaticResource PurpleColor}"/>
    <SolidColorBrush x:Key="DangerBrush"
                     Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush"
                     Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"
                     Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ConsoleBackgroundBrush"
                     Color="{StaticResource ConsoleBackgroundColor}"/>
    <SolidColorBrush x:Key="ConsoleTextBrush"
                     Color="{StaticResource ConsoleTextColor}"/>
    <SolidColorBrush x:Key="MetricGlowBrush"
                     Color="#172D3B45"/>
    <SolidColorBrush x:Key="AccentChartFillBrush"
                     Color="#2E25CDBB"/>
    <SolidColorBrush x:Key="PurpleChartFillBrush"
                     Color="#2AA78BCE"/>
    <SolidColorBrush x:Key="SuccessChartFillBrush"
                     Color="#2859C99A"/>
    <SolidColorBrush x:Key="DangerChartFillBrush"
                     Color="#24E8767F"/>
    <SolidColorBrush x:Key="DimTrackBrush"
                     Color="#1B2834"/>
    <LinearGradientBrush x:Key="ShellPanelBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#15212B"
                      Offset="0"/>
        <GradientStop Color="#101820"
                      Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardPanelBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#1A2732"
                      Offset="0"/>
        <GradientStop Color="#121B24"
                      Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MetricPanelBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Color="#1C2B37"
                      Offset="0"/>
        <GradientStop Color="#15212B"
                      Offset="0.66"/>
        <GradientStop Color="#101820"
                      Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                     Color="{StaticResource TableSelectedColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                     Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                     Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                     Color="{StaticResource PanelBackgroundColor}"/>
</ResourceDictionary>
