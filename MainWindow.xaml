<Window x:Class="ServerControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ServerControlCenter.Controls"
        xmlns:services="clr-namespace:ServerControlCenter.Services"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Server Control Center"
        Width="1320"
        Height="840"
        MinWidth="1080"
        MinHeight="600"
        Icon="Assets/server-control-center.ico"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="PackIconStyle"
               TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width"
                    Value="17"/>
            <Setter Property="Height"
                    Value="17"/>
            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style>
        <Style x:Key="ModernTabControlStyle"
               TargetType="{x:Type TabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid UseLayoutRounding="True"
                              SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#07111B"
                                    BorderBrush="#102235"
                                    BorderThickness="0 0 0 1"
                                    Padding="10 0">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          Margin="0"
                                          VerticalAlignment="Bottom"/>
                            </Border>

                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTabItemStyle"
               TargetType="{x:Type TabItem}">
            <Setter Property="Foreground"
                    Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Padding"
                    Value="10 0"/>
            <Setter Property="Margin"
                    Value="0 0 6 0"/>
            <Setter Property="MinHeight"
                    Value="36"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderBrush"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid UseLayoutRounding="True"
                              SnapsToDevicePixels="True">
                            <Border x:Name="HoverBackground"
                                    Height="32"
                                    CornerRadius="10"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>

                            <Border x:Name="ActiveLine"
                                    Height="2"
                                    CornerRadius="1"
                                    Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Bottom"
                                    Margin="12 0"
                                    Opacity="0"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextBrush}"/>
                                <Setter TargetName="ActiveLine"
                                        Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="{StaticResource ShellPanelBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0 0 1 0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="116"/>
                    <RowDefinition Height="178"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="18 0"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0 0 0 1">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="30"
                                Height="30"
                                CornerRadius="7"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                Margin="0 0 10 0">
                            <iconPacks:PackIconMaterial Kind="ServerNetwork"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Server Control"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="14 14 14 12">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddServerCommand}"
                            Height="38"
                            ToolTip="{Binding [AddServer], Source={x:Static services:AppServices.Localizer}}"
                            Margin="0 0 0 14">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Plus"
                                                        Style="{StaticResource PackIconStyle}"
                                                        Margin="0 0 8 0"/>
                            <TextBlock Text="{Binding [AddServer], Source={x:Static services:AppServices.Localizer}}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding [SearchServers], Source={x:Static services:AppServices.Localizer}}"
                               Style="{StaticResource SmallMutedTextStyle}"
                               Margin="4 0 0 0"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            Margin="14 0 14 10">
                    <Grid Margin="4 0 2 8">
                        <TextBlock Text="{Binding [Groups], Source={x:Static services:AppServices.Localizer}}"
                                   Style="{StaticResource SmallMutedTextStyle}"/>

                    </Grid>
                    <ListBox ItemsSource="{Binding Groups}"
                             MaxHeight="142">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Name}"
                                        HorizontalContentAlignment="Stretch"
                                        ToolTip="{Binding Name}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0">
                                    <Border Padding="8 7"
                                            CornerRadius="6">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{StaticResource SubtleBackgroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                                        Kind="FolderMultiple"
                                                                        Style="{StaticResource PackIconStyle}"
                                                                        Foreground="{StaticResource MutedTextBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Count}"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="8 0 0 0"/>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Margin="14 0">
                    <TextBlock Text="{Binding [Servers], Source={x:Static services:AppServices.Localizer}}"
                               Style="{StaticResource SmallMutedTextStyle}"
                               Margin="4 0 0 10"/>
                    <ListBox ItemsSource="{Binding FilteredServers}"
                             SelectedItem="{Binding SelectedServer}"
                             MouseDoubleClick="ServersListBox_MouseDoubleClick"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{Binding [Edit], Source={x:Static services:AppServices.Localizer}}"
                                          Command="{Binding EditServerCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial Kind="Pencil"
                                                                    Style="{StaticResource PackIconStyle}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding [TestSsh], Source={x:Static services:AppServices.Localizer}}"
                                          Command="{Binding TestConnectionCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial Kind="LanConnect"
                                                                    Style="{StaticResource PackIconStyle}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding [ToggleFavorite], Source={x:Static services:AppServices.Localizer}}"
                                          Command="{Binding ToggleSelectedServerFavoriteCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial Kind="Star"
                                                                    Style="{StaticResource PackIconStyle}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{Binding [Delete], Source={x:Static services:AppServices.Localizer}}"
                                          Command="{Binding DeleteServerCommand}">
                                    <MenuItem.Icon>
                                        <iconPacks:PackIconMaterial Kind="Delete"
                                                                    Style="{StaticResource PackIconStyle}"
                                                                    Foreground="{StaticResource DangerBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        CornerRadius="6"
                                        Background="{StaticResource CardPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="9"
                                                 Height="9"
                                                 Margin="0 5 10 0"
                                                 VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill"
                                                            Value="#8CA0B2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}"
                                                                     Value="True">
                                                            <Setter Property="Fill"
                                                                    Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayOs}"
                                                       Style="{StaticResource SmallMutedTextStyle}"
                                                       Margin="0 2 0 0"/>
                                            <TextBlock Text="{Binding DisplayAddress}"
                                                       Style="{StaticResource SmallMutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <iconPacks:PackIconMaterial Grid.Column="2"
                                                                    Kind="Star"
                                                                    Width="16"
                                                                    Height="16"
                                                                    Margin="10 0 0 0">
                                            <iconPacks:PackIconMaterial.Style>
                                                <Style TargetType="iconPacks:PackIconMaterial"
                                                       BasedOn="{StaticResource PackIconStyle}">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}"
                                                                     Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </iconPacks:PackIconMaterial.Style>
                                        </iconPacks:PackIconMaterial>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Margin="8 28 8 0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFilteredServers}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <iconPacks:PackIconMaterial Kind="ServerOff"
                                                    Width="28"
                                                    Height="28"
                                                    Foreground="{StaticResource MutedTextBrush}"
                                                    HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding [NoServers], Source={x:Static services:AppServices.Localizer}}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0 10 0 4"/>
                        <TextBlock Text="{Binding [NoServersHint], Source={x:Static services:AppServices.Localizer}}"
                                   Style="{StaticResource TinyMutedTextStyle}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="4"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0 1 0 0"
                        Padding="14 8"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                BorderThickness="0"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Command="{Binding AddServerCommand}"
                                ToolTip="{Binding [AddServer], Source={x:Static services:AppServices.Localizer}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Plus"
                                                            Style="{StaticResource PackIconStyle}"
                                                            Margin="0 0 0 0"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [Favorites], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding OpenFavoritesPanelCommand}"
                                Margin="4 0">
                            <iconPacks:PackIconMaterial Kind="Star"
                                                        Style="{StaticResource PackIconStyle}"/>
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [Settings], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding OpenSettingsPanelCommand}"
                                Margin="4 0">
                            <iconPacks:PackIconMaterial Kind="Cog"
                                                        Style="{StaticResource PackIconStyle}"/>
                        </Button>
                        <Button Grid.Column="3"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [Activity], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding OpenActivityPanelCommand}"
                                Margin="4 0 0 0">
                            <iconPacks:PackIconMaterial Kind="Bell"
                                                        Style="{StaticResource PackIconStyle}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Grid.Row="0"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0 0 0 1"
                Padding="18 0"
                Background="#070E15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Center"
                      Margin="0 0 18 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="7"
                             Height="7"
                             Margin="0 0 12 0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill"
                                        Value="#8CA0B2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedServer.IsOnline}"
                                                 Value="True">
                                        <Setter Property="Fill"
                                                Value="{StaticResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding SelectedServerTitle}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                            <TextBlock Text="{Binding SelectedServerSubtitle}"
                                       Style="{StaticResource TinyMutedTextStyle}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="&#x2022;"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="8 0"/>
                            <TextBlock Text="{Binding OnlineText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TinyMutedTextStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedServer.IsOnline}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1"
                      Width="200"
                      VerticalAlignment="Center"
                      Margin="0 0 16 0">
                    <TextBox x:Name="ServerSearchBox"
                             Text="{Binding ServerSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="34 5 78 5"
                             ToolTip="{Binding [SearchServers], Source={x:Static services:AppServices.Localizer}}"/>
                    <iconPacks:PackIconMaterial Kind="Magnify"
                                                Width="16"
                                                Height="16"
                                                Foreground="{StaticResource MutedTextBrush}"
                                                Margin="12 0 0 0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"/>
                    <Border Background="#101B28"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5 1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0 0 6 0">
                        <TextBlock Text="Ctrl+K"
                                   Style="{StaticResource TinyMutedTextStyle}"/>
                    </Border>
                </Grid>
                <Button Grid.Column="2"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{Binding [TestSsh], Source={x:Static services:AppServices.Localizer}}"
                        Command="{Binding TestConnectionCommand}"
                        Margin="0 0 8 0">
                    <iconPacks:PackIconMaterial Kind="CheckNetworkOutline"
                                                Style="{StaticResource PackIconStyle}"/>
                </Button>
                <Button Grid.Column="3"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{Binding [Edit], Source={x:Static services:AppServices.Localizer}}"
                        Command="{Binding EditServerCommand}"
                        Margin="0 0 8 0">
                    <iconPacks:PackIconMaterial Kind="Pencil"
                                                Style="{StaticResource PackIconStyle}"/>
                </Button>
                <Button Grid.Column="4"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="{Binding [CheckAllServers], Source={x:Static services:AppServices.Localizer}}"
                        Command="{Binding CheckAllServersCommand}"
                        Margin="0 0 8 0">
                    <iconPacks:PackIconMaterial Kind="Refresh"
                                                Style="{StaticResource PackIconStyle}"/>
                </Button>
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="{Binding [Activity], Source={x:Static services:AppServices.Localizer}}"
                            Command="{Binding OpenActivityPanelCommand}"
                            Margin="0 0 8 0">
                        <iconPacks:PackIconMaterial Kind="Bell"
                                                    Style="{StaticResource PackIconStyle}"/>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="{Binding [Settings], Source={x:Static services:AppServices.Localizer}}"
                            Command="{Binding OpenSettingsPanelCommand}"
                            Margin="0 0 8 0">
                        <iconPacks:PackIconMaterial Kind="Cog"
                                                    Style="{StaticResource PackIconStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Grid.Row="1"
              Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="124"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="0.9*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="1.25*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="0.72*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadgeStyle}"
                                    Margin="0 0 10 0">
                                <iconPacks:PackIconMaterial Kind="Chip"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CPU"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding MonitorCpuPercent, StringFormat={}{0:0}%}"
                                   FontSize="28"
                                   Margin="0 6 10 0"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding MonitorCpu}"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <controls:SparklineChart Grid.Column="1"
                                                 Grid.RowSpan="3"
                                                 Values="{Binding CpuHistory}"
                                                 Stroke="{StaticResource AccentBrush}"
                                                 Fill="{StaticResource AccentChartFillBrush}"
                                                 ShowGrid="False"
                                                 Height="76"
                                                 VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadgeStyle}"
                                    Background="#1C1441"
                                    BorderBrush="#3E2673"
                                    Margin="0 0 10 0">
                                <iconPacks:PackIconMaterial Kind="Memory"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{StaticResource PurpleBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="RAM"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding MonitorRamPercent, StringFormat={}{0:0}%}"
                                   FontSize="28"
                                   Margin="0 6 10 0"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding MonitorRam}"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                        <controls:SparklineChart Grid.Column="1"
                                                 Grid.RowSpan="3"
                                                 Values="{Binding RamHistory}"
                                                 Stroke="{StaticResource PurpleBrush}"
                                                 Fill="{StaticResource PurpleChartFillBrush}"
                                                 ShowGrid="False"
                                                 Height="76"
                                                 VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconBadgeStyle}"
                                    Background="#0C3629"
                                    BorderBrush="#1F6049"
                                    Margin="0 0 10 0">
                                <iconPacks:PackIconMaterial Kind="Harddisk"
                                                            Width="17"
                                                            Height="17"
                                                            Foreground="{StaticResource SuccessBrush}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="DISK"
                                       Style="{StaticResource SectionTitleTextStyle}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding MonitorDiskPercent, StringFormat={}{0:0}%}"
                                   FontSize="28"
                                   Margin="0 6 10 0"/>
                        <TextBlock Grid.Row="2"
                                   Text="{Binding MonitorDiskUsage}"
                                   Style="{StaticResource SmallMutedTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding MonitorDiskUsage}"/>
                        <controls:SparklineChart Grid.Column="1"
                                                 Grid.RowSpan="3"
                                                 Values="{Binding DiskHistory}"
                                                 Stroke="{StaticResource SuccessBrush}"
