                                                            Style="{StaticResource PackIconStyle}"
                                                            Margin="0 0 8 0"/>
                                <TextBlock Text="{Binding [Commands], Source={x:Static services:AppServices.Localizer}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Background="#08131D">
                                <ListBox ItemsSource="{Binding SavedCommands}"
                                         SelectedItem="{Binding SelectedSavedCommand}"
                                         Margin="8"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12 10"
                                                    CornerRadius="7"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    Background="{StaticResource TableRowBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Command}"
                                                                   Style="{StaticResource SmallMutedTextStyle}"
                                                                   FontFamily="Consolas"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0 4 0 0"/>
                                                    </StackPanel>
                                                    <iconPacks:PackIconMaterial Grid.Column="1"
                                                                                Kind="ClockOutline"
                                                                                Style="{StaticResource PackIconStyle}"
                                                                                Foreground="{StaticResource MutedTextBrush}"
                                                                                Margin="12 0 0 0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox Text="{Binding CommandTitle, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding [CommandName], Source={x:Static services:AppServices.Localizer}}"/>
                                <TextBox Grid.Row="2"
                                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         ToolTip="{Binding [CommandText], Source={x:Static services:AppServices.Localizer}}"/>
                                <WrapPanel Grid.Row="4"
                                           HorizontalAlignment="Right">
                                    <Button HorizontalAlignment="Left"
                                            Command="{Binding AddSavedCommandCommand}"
                                            ToolTip="{Binding [AddCommand], Source={x:Static services:AppServices.Localizer}}"
                                            Margin="0 0 6 0">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Plus"
                                                                        Style="{StaticResource PackIconStyle}"
                                                                        Margin="0 0 8 0"/>
                                            <TextBlock Text="{Binding [AddCommand], Source={x:Static services:AppServices.Localizer}}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            ToolTip="{Binding [SaveCommand], Source={x:Static services:AppServices.Localizer}}"
                                            Command="{Binding UpdateSavedCommandCommand}"
                                            Margin="0 0 6 0">
                                        <iconPacks:PackIconMaterial Kind="ContentSave"
                                                                    Style="{StaticResource PackIconStyle}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            ToolTip="{Binding [ToggleFavorite], Source={x:Static services:AppServices.Localizer}}"
                                            Command="{Binding ToggleSavedCommandFavoriteCommand}"
                                            Margin="0 0 6 0">
                                        <iconPacks:PackIconMaterial Kind="Star"
                                                                    Style="{StaticResource PackIconStyle}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            ToolTip="{Binding [Delete], Source={x:Static services:AppServices.Localizer}}"
                                            Command="{Binding DeleteSavedCommandCommand}"
                                            Margin="0 0 6 0">
                                        <iconPacks:PackIconMaterial Kind="Delete"
                                                                    Style="{StaticResource PackIconStyle}"
                                                                    Foreground="{StaticResource DangerBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{Binding [Run], Source={x:Static services:AppServices.Localizer}}"
                                            Command="{Binding RunSavedCommandCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="Play"
                                                                        Style="{StaticResource PackIconStyle}"
                                                                        Foreground="White"
                                                                        Margin="0 0 8 0"/>
                                            <TextBlock Text="{Binding [Run], Source={x:Static services:AppServices.Localizer}}"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="MonitorDashboard"
                                                            Style="{StaticResource PackIconStyle}"
                                                            Margin="0 0 8 0"/>
                                <TextBlock Text="{Binding [ServerInspector], Source={x:Static services:AppServices.Localizer}}"/>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource SoftCardBorderStyle}"
                                            Margin="0 0 0 10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedServerTitle}"
                                                       Style="{StaticResource TitleTextStyle}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SelectedServerSubtitle}"
                                                       Style="{StaticResource SmallMutedTextStyle}"
                                                       Margin="0 5 0 0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SelectedServerOs}"
                                                       Style="{StaticResource SmallMutedTextStyle}"
                                                       Margin="0 3 0 0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SoftCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding [Status], Source={x:Static services:AppServices.Localizer}}"
                                                       Style="{StaticResource SectionTitleTextStyle}"
                                                       Margin="0 0 0 8"/>
                                            <TextBlock Text="{Binding MonitorLoad}"
                                                       Style="{StaticResource SmallMutedTextStyle}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding MonitorProcesses}"
                                                       Style="{StaticResource SmallMutedTextStyle}"
                                                       Margin="0 8 0 0"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas"/>
                                            <TextBlock Text="{Binding MonitorNetwork}"
                                                       Style="{StaticResource SmallMutedTextStyle}"
                                                       Margin="0 8 0 0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Column="2"
                                    Style="{StaticResource SoftCardBorderStyle}"
                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="0 0 0 1"
                                            Padding="12 0">
                                        <Grid>
                                            <TextBlock Text="{Binding [RecentLogs], Source={x:Static services:AppServices.Localizer}}"
                                                       Style="{StaticResource SectionTitleTextStyle}"/>
                                            <Button Content="{Binding [ViewAll], Source={x:Static services:AppServices.Localizer}}"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Right"
                                                    ToolTip="{Binding [ActivityLog], Source={x:Static services:AppServices.Localizer}}"
                                                    Command="{Binding OpenActivityPanelCommand}"
                                                    Padding="4 0"/>
                                        </Grid>
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding RecentLogs}"
                                             Margin="8"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="9 7"
                                                        CornerRadius="6"
                                                        Background="{StaticResource TableRowBrush}"
                                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                                        BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="58"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Grid.Column="0"
                                                                 Width="8"
                                                                 Height="8"
                                                                 Margin="0 5 10 0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill"
                                                                            Value="{StaticResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}"
                                                                                     Value="warn">
                                                                            <Setter Property="Fill"
                                                                                    Value="{StaticResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}"
                                                                                     Value="error">
                                                                            <Setter Property="Fill"
                                                                                    Value="{StaticResource DangerBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Time}"
                                                                   Style="{StaticResource SmallMutedTextStyle}"/>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Service}"
                                                                   Style="{StaticResource SmallMutedTextStyle}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding Message}"
                                                                   Style="{StaticResource SmallMutedTextStyle}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

        </Grid>

        <Border Grid.ColumnSpan="2"
                Grid.RowSpan="2"
                Background="#99050A0F"
                Visibility="{Binding IsSettingsPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PagePanelStyle}"
                    Width="560"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0 0 0 14">
                        <TextBlock Text="{Binding [Settings], Source={x:Static services:AppServices.Localizer}}"
                                   Style="{StaticResource TitleTextStyle}"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Right"
                                ToolTip="{Binding [Close], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding CloseOverlayPanelsCommand}">
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Style="{StaticResource PackIconStyle}"/>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding [Language], Source={x:Static services:AppServices.Localizer}}"
                               Style="{StaticResource SmallMutedTextStyle}"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedValue="{Binding AppSettings.LanguageCode, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="Name"
                              Margin="0 6 0 12"/>
                    <TextBlock Text="{Binding [MonitoringInterval], Source={x:Static services:AppServices.Localizer}}"
                               Style="{StaticResource SmallMutedTextStyle}"/>
                    <TextBox Text="{Binding MonitoringIntervalInput, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             Margin="0 6 0 12"/>
                    <TextBlock Text="{Binding [DefaultRemoteFolder], Source={x:Static services:AppServices.Localizer}}"
                               Style="{StaticResource SmallMutedTextStyle}"/>
                    <TextBox Text="{Binding AppSettings.DefaultRemoteFolder, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0 6 0 12"/>
                    <TextBlock Text="{Binding [DefaultLogPath], Source={x:Static services:AppServices.Localizer}}"
                               Style="{StaticResource SmallMutedTextStyle}"/>
                    <TextBox Text="{Binding AppSettings.DefaultLogPath, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0 6 0 12"/>
                    <CheckBox Content="{Binding [AutoRefreshMonitoring], Source={x:Static services:AppServices.Localizer}}"
                              IsChecked="{Binding AppSettings.AutoRefreshMonitoring}"
                              Margin="0 0 0 16"/>
                    <TextBlock Text="{Binding SettingsStatusMessage}"
                               Style="{StaticResource SmallMutedTextStyle}"
                               TextWrapping="Wrap"
                               Margin="0 0 0 12"/>
                    <Button Content="{Binding [SaveSettings], Source={x:Static services:AppServices.Localizer}}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="{Binding [SaveSettings], Source={x:Static services:AppServices.Localizer}}"
                            Command="{Binding SaveSettingsCommand}"/>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2"
                Grid.RowSpan="2"
                Background="#99050A0F"
                Visibility="{Binding IsFavoritesPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PagePanelStyle}"
                    Width="680"
                    Height="520"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0 0 0 14">
                        <TextBlock Text="{Binding [Favorites], Source={x:Static services:AppServices.Localizer}}"
                                   Style="{StaticResource TitleTextStyle}"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Right"
                                ToolTip="{Binding [Close], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding CloseOverlayPanelsCommand}">
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Style="{StaticResource PackIconStyle}"/>
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [Servers], Source={x:Static services:AppServices.Localizer}}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Margin="0 0 0 10"/>
                            <ListBox ItemsSource="{Binding FavoriteServers}"
                                     SelectedItem="{Binding SelectedServer}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SoftCardBorderStyle}"
                                                Margin="0 0 0 8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Host}"
                                                           Style="{StaticResource SmallMutedTextStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [Commands], Source={x:Static services:AppServices.Localizer}}"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Margin="0 0 0 10"/>

                            <ListBox ItemsSource="{Binding FavoriteCommands}"
                                     SelectedItem="{Binding SelectedSavedCommand}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SoftCardBorderStyle}"
                                                Margin="0 0 0 8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Command}"
                                                           Style="{StaticResource SmallMutedTextStyle}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2"
                Grid.RowSpan="2"
                Background="#99050A0F"
                Visibility="{Binding IsActivityPanelOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource PagePanelStyle}"
                    Width="760"
                    Height="560"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0 0 0 14">
                        <TextBlock Text="{Binding [ActivityLog], Source={x:Static services:AppServices.Localizer}}"
                                   Style="{StaticResource TitleTextStyle}"/>
                        <Button Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Right"
                                ToolTip="{Binding [Close], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding CloseOverlayPanelsCommand}">
                            <iconPacks:PackIconMaterial Kind="Close"
                                                        Style="{StaticResource PackIconStyle}"/>
                        </Button>
                    </Grid>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ActivityLogs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding [Time], Source={x:Static services:AppServices.Localizer}}"
                                                Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM HH:mm:ss}}"
                                                Width="130"/>
                            <DataGridTextColumn Header="{Binding [Activity], Source={x:Static services:AppServices.Localizer}}"
                                                Binding="{Binding Action}"
                                                Width="120"/>
                            <DataGridTextColumn Header="{Binding [Target], Source={x:Static services:AppServices.Localizer}}"
                                                Binding="{Binding Target}"
                                                Width="150"/>
                            <DataGridTextColumn Header="{Binding [Details], Source={x:Static services:AppServices.Localizer}}"
                                                Binding="{Binding Details}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="2"
                            Content="{Binding [ClearLog], Source={x:Static services:AppServices.Localizer}}"
                            Style="{StaticResource DangerButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0 12 0 0"
                            ToolTip="{Binding [ClearLog], Source={x:Static services:AppServices.Localizer}}"
                            Command="{Binding ClearActivityLogsCommand}"/>
                </Grid>
            </Border>
        </Border>
    </Grid>

</Window>
