<Window x:Class="ServerControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:features="clr-namespace:ServerControlCenter.Views.Features"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:services="clr-namespace:ServerControlCenter.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Server Control Center"
        Width="1320"
        Height="840"
        MinWidth="1080"
        MinHeight="600"
        Icon="Assets/server-control-center.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="7"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="41"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="MinHeight" Value="41"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Margin="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B94D58"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowBorder"
            Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#121B23"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0 0 0 1"
                    CornerRadius="10 10 0 0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14 0">
                        <Border Width="24"
                                Height="24"
                                CornerRadius="6"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                Margin="0 0 10 0">
                            <iconPacks:PackIconMaterial Kind="ServerNetwork"
                                                        Width="15"
                                                        Height="15"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Server Control Center"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"/>
                        <Border Width="5"
                                Height="5"
                                CornerRadius="3"
                                Background="{StaticResource AccentBrush}"
                                Margin="10 1 0 0"
                                Opacity="0.8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="0 0 4 0">
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="{Binding [Minimize], Source={x:Static services:AppServices.Localizer}}"
                                Click="MinimizeButton_Click">
                            <Path Width="12" Height="12"
                                  Data="M 1,7.5 L 11,7.5"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.4" Stretch="None"
                                  SnapsToDevicePixels="True"/>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="{Binding [Maximize], Source={x:Static services:AppServices.Localizer}}"
                                Click="MaximizeButton_Click">
                            <Path x:Name="MaximizeGlyph" Width="12" Height="12"
                                  Data="M 2,2 L 10,2 L 10,10 L 2,10 Z"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.35" Stretch="None"
                                  SnapsToDevicePixels="True"/>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButtonStyle}"
                                ToolTip="{Binding [Close], Source={x:Static services:AppServices.Localizer}}"
                                Click="CloseButton_Click">
                            <Path Width="13" Height="13"
                                  Data="M 2,2 L 11,11 M 11,2 L 2,11"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.65"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="None" SnapsToDevicePixels="True"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="{StaticResource AppBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <features:ServersSidebarView Grid.RowSpan="2" Grid.Column="0"/>
                <features:DashboardHeaderView x:Name="DashboardHeader" Grid.Column="1" Grid.Row="0"/>

                <Grid Grid.Column="1" Grid.Row="1" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="124"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="0.9*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="1.25*"/>
                    </Grid.RowDefinitions>
                    <features:MonitoringSummaryView Grid.Row="0"/>
                    <features:TerminalView Grid.Row="2"/>
                    <GridSplitter Grid.Row="3"
                                  Height="10"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="Transparent"
                                  ShowsPreview="True"
                                  ResizeDirection="Rows">
                        <GridSplitter.Template>
                            <ControlTemplate TargetType="{x:Type GridSplitter}">
                                <Border Background="Transparent" Padding="0 4">
                                    <Border Height="2"
                                            CornerRadius="1"
                                            Background="{StaticResource BorderBrushStrong}"
                                            Opacity="0.55"/>
                                </Border>
                            </ControlTemplate>
                        </GridSplitter.Template>
                    </GridSplitter>
                    <features:OperationsView Grid.Row="4"/>
                </Grid>

                <features:OverlayHostView Grid.ColumnSpan="2" Grid.RowSpan="2"/>
            </Grid>
        </Grid>
    </Border>
</Window>
