<Window x:Class="ServerControlCenter.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ServerControlCenter.Services"
        Title="{Binding [WindowInputTitle], Source={x:Static services:AppServices.Localizer}}"
        Height="190"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptTextBlock"
                   Grid.Row="0"
                   Style="{StaticResource SectionTitleTextStyle}"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="ValueTextBox"
                 Grid.Row="2"
                 VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{Binding [Cancel], Source={x:Static services:AppServices.Localizer}}"
                    MinWidth="90"
                    Margin="0 0 8 0"
                    ToolTip="{Binding [Cancel], Source={x:Static services:AppServices.Localizer}}"
                    IsCancel="True"/>
            <Button Content="{Binding [Confirm], Source={x:Static services:AppServices.Localizer}}"
                    MinWidth="90"
                    Style="{StaticResource PrimaryButtonStyle}"
                    ToolTip="{Binding [Confirm], Source={x:Static services:AppServices.Localizer}}"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
