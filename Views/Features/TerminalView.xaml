<UserControl x:Class="ServerControlCenter.Views.Features.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:ServerControlCenter.Services"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Border Grid.Row="2"
            Style="{StaticResource PagePanelStyle}"
            Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0 0 0 1"
                    Padding="14 6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0 0 10 0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill"
                                            Value="{StaticResource MutedTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedServer.IsOnline}"
                                                     Value="True">
                                            <Setter Property="Fill"
                                                    Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding [Terminal], Source={x:Static services:AppServices.Localizer}}"
                                   Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding TerminalSessionStatus}"
                                   Style="{StaticResource TinyMutedTextStyle}"
                                   Margin="14 0 0 0"
                                   MaxWidth="420"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding TerminalSessionStatus}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [ClearTerminal], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding ClearTerminalCommand}"
                                Margin="0 0 8 0">
                            <iconPacks:PackIconMaterial Kind="Broom" Style="{StaticResource PackIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [InterruptTerminalShortcut], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding InterruptTerminalCommandCommand}"
                                IsEnabled="{Binding IsTerminalConnected}"
                                Margin="0 0 8 0">
                            <iconPacks:PackIconMaterial Kind="StopCircleOutline" Style="{StaticResource PackIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [DisconnectTerminal], Source={x:Static services:AppServices.Localizer}}"
                                Command="{Binding DisconnectTerminalCommand}"
                                IsEnabled="{Binding IsTerminalConnected}"
                                Margin="0 0 8 0">
                            <iconPacks:PackIconMaterial Kind="Logout" Style="{StaticResource PackIconStyle}"/>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [More], Source={x:Static services:AppServices.Localizer}}"
                                Click="OpenButtonContextMenu_Click">
                            <Button.Content>
                                <iconPacks:PackIconMaterial Kind="DotsHorizontal"
                                                            Style="{StaticResource PackIconStyle}"/>
                            </Button.Content>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="{Binding [AddServer], Source={x:Static services:AppServices.Localizer}}"
                                              Command="{Binding AddServerCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconMaterial Kind="Plus"
                                                                        Style="{StaticResource PackIconStyle}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding [Files], Source={x:Static services:AppServices.Localizer}}"
                                              Command="{Binding LoadRemoteFilesCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconMaterial Kind="Folder"
                                                                        Style="{StaticResource PackIconStyle}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding [OpenSystemTerminal], Source={x:Static services:AppServices.Localizer}}"
                                              Command="{Binding OpenSystemTerminalCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconMaterial Kind="OpenInNew" Style="{StaticResource PackIconStyle}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="{Binding [Settings], Source={x:Static services:AppServices.Localizer}}"
                                              Command="{Binding OpenSettingsPanelCommand}">
                                        <MenuItem.Icon>
                                            <iconPacks:PackIconMaterial Kind="Cog"
                                                                        Style="{StaticResource PackIconStyle}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ProgressBar Grid.Row="1"
                         Height="3"
                         VerticalAlignment="Top"
                         IsIndeterminate="True"
                         Visibility="{Binding IsCommandRunning, Converter={StaticResource BoolToVisibility}}"
                         Panel.ZIndex="2"/>
            <TextBox x:Name="TerminalOutputTextBox"
                     Grid.Row="1"
                     Text="{Binding TerminalOutput}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     Style="{StaticResource ConsoleTextBoxStyle}"
                     TextChanged="TerminalOutputTextBox_TextChanged"
                     PreviewKeyDown="TerminalOutputTextBox_PreviewKeyDown"
                     PreviewTextInput="TerminalOutputTextBox_PreviewTextInput"
                     BorderThickness="0"/>
            <Grid Grid.Row="2"
                  Margin="12 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TerminalInputTextBox"
                         Grid.Column="0"
                         Text="{Binding TerminalCommand, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding [TerminalInputPlaceholder], Source={x:Static services:AppServices.Localizer}}"
                         Height="34"
                         Padding="10 5"
                         FontFamily="Consolas"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="TerminalCommandTextBox_KeyDown"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="{Binding [SendSshCommand], Source={x:Static services:AppServices.Localizer}}"
                            MinWidth="44"
                            Command="{Binding SendTerminalCommandCommand}">
                        <iconPacks:PackIconMaterial Kind="Send" Style="{StaticResource PackIconStyle}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
