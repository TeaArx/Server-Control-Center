<UserControl x:Class="ServerControlCenter.Views.Features.CommandsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServerControlCenter.Controls"
             xmlns:services="clr-namespace:ServerControlCenter.Services"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="7"
                Background="#101A22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="14 12 14 6">
                    <TextBlock Text="{Binding [SavedCommands], Source={x:Static services:AppServices.Localizer}}"
                               Style="{StaticResource SectionTitleTextStyle}"/>
                </StackPanel>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding SavedCommands}"
                     SelectedItem="{Binding SelectedSavedCommand}"
                     Margin="8"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12 10"
                                CornerRadius="7"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                Background="{StaticResource TableRowBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#1A3738"
                                                CornerRadius="4"
                                                Margin="8 0 0 0"
                                                Padding="6 1">
                                            <TextBlock Text="{Binding Category}"
                                                       Style="{StaticResource TinyMutedTextStyle}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}"
                                               Style="{StaticResource SmallMutedTextStyle}"
                                               FontFamily="Consolas"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0 4 0 0"/>
                                </StackPanel>
                                <iconPacks:PackIconMaterial Grid.Column="1"
                                                            Margin="12 0 0 0">
                                    <iconPacks:PackIconMaterial.Style>
                                        <Style TargetType="iconPacks:PackIconMaterial" BasedOn="{StaticResource PackIconStyle}">
                                            <Setter Property="Kind" Value="StarOutline"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Kind" Value="Star"/>
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </iconPacks:PackIconMaterial.Style>
                                </iconPacks:PackIconMaterial>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding [CommandName], Source={x:Static services:AppServices.Localizer}}"
                           Style="{StaticResource SmallMutedTextStyle}"
                           Margin="2 0 0 5"/>
                <TextBox Text="{Binding CommandTitle, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding [CommandText], Source={x:Static services:AppServices.Localizer}}"
                           Style="{StaticResource SmallMutedTextStyle}"
                           Margin="2 0 0 5"/>
                <TextBox Grid.Row="1"
                         Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"/>
            </Grid>
            <WrapPanel Grid.Row="4"
                       HorizontalAlignment="Right">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{Binding AddSavedCommandCommand}"
                        ToolTip="{Binding [AddCommand], Source={x:Static services:AppServices.Localizer}}"
                        Margin="0 0 6 0">
                    <iconPacks:PackIconMaterial Kind="Plus" Style="{StaticResource PackIconStyle}"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="{Binding [SaveCommand], Source={x:Static services:AppServices.Localizer}}"
                        Command="{Binding UpdateSavedCommandCommand}"
                        Margin="0 0 6 0">
                    <iconPacks:PackIconMaterial Kind="ContentSave" Style="{StaticResource PackIconStyle}"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="{Binding SelectedCommandFavoriteAction}"
                        Command="{Binding ToggleSavedCommandFavoriteCommand}"
                        Margin="0 0 6 0">
                    <iconPacks:PackIconMaterial Kind="Star" Style="{StaticResource PackIconStyle}" Foreground="{StaticResource WarningBrush}"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}"
                        ToolTip="{Binding [Delete], Source={x:Static services:AppServices.Localizer}}"
                        Command="{Binding DeleteSavedCommandCommand}"
                        Margin="0 0 6 0">
                    <iconPacks:PackIconMaterial Kind="Delete"
                                                Style="{StaticResource PackIconStyle}"
                                                Foreground="{StaticResource DangerBrush}"/>
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="{Binding [Run], Source={x:Static services:AppServices.Localizer}}"
                        Command="{Binding RunSavedCommandCommand}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Play"
                                                    Style="{StaticResource PackIconStyle}"
                                                    Foreground="White"
                                                    Margin="0 0 8 0"/>
                        <TextBlock Text="{Binding [Run], Source={x:Static services:AppServices.Localizer}}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
