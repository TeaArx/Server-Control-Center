<Window x:Class="ServerControlCenter.Views.RemoteFileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ServerControlCenter.Services"
        Title="{Binding [WindowFileEditorTitle], Source={x:Static services:AppServices.Localizer}}"
        Height="650"
        Width="920"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SoftCardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding RemotePath}"
                           FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1"
                        Content="{Binding [Save], Source={x:Static services:AppServices.Localizer}}"
                        MinWidth="110"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="{Binding [Save], Source={x:Static services:AppServices.Localizer}}"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>

        <TextBox Grid.Row="2"
                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 Style="{StaticResource ConsoleTextBoxStyle}"/>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource SmallMutedTextStyle}"
                   Margin="0 10 0 0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
