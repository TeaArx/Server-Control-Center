<Window x:Class="ServerControlCenter.Views.ServerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:ServerControlCenter.Services"
        Title="{Binding WindowTitle}"
        Height="700"
        Width="620"
        MinWidth="560"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 14">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="{Binding [ProfileStoredLocally], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}" Margin="0 4 0 0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PagePanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Name], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="IP / Host" Style="{StaticResource SmallMutedTextStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [Port], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding [Username], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding [Password], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}"/>
                <PasswordBox x:Name="PasswordInput"
                             Grid.Row="8"
                             Grid.Column="1"
                             PasswordChanged="PasswordInput_PasswordChanged"/>

                <TextBlock Grid.Row="10" Grid.Column="0" Text="{Binding [PrivateKey], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}"/>
                <Grid Grid.Row="10" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="{Binding [PickPrivateKey], Source={x:Static services:AppServices.Localizer}}" MinWidth="92" ToolTip="{Binding [PickPrivateKey], Source={x:Static services:AppServices.Localizer}}" Command="{Binding PickPrivateKeyCommand}"/>
                </Grid>

                <TextBlock Grid.Row="12" Grid.Column="0" Text="{Binding [Group], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}"/>
                <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="14" Grid.Column="0" Text="{Binding [Os], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}"/>
                <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding OsName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="16" Grid.Column="0" Text="IP" Style="{StaticResource SmallMutedTextStyle}"/>
                <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding IpAddressDisplay, UpdateSourceTrigger=PropertyChanged}"/>

                <CheckBox Grid.Row="18" Grid.Column="1" Content="{Binding [Favorite], Source={x:Static services:AppServices.Localizer}}" IsChecked="{Binding IsFavorite}" Foreground="{StaticResource TextBrush}"/>

                <TextBlock Grid.Row="20" Grid.Column="0" Text="{Binding [Notes], Source={x:Static services:AppServices.Localizer}}" Style="{StaticResource SmallMutedTextStyle}" VerticalAlignment="Top" Margin="0 8 0 0"/>
                <TextBox Grid.Row="20" Grid.Column="1"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0 14 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource SmallMutedTextStyle}" TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{Binding [TestSsh], Source={x:Static services:AppServices.Localizer}}" MinWidth="124" Margin="0 0 8 0" ToolTip="{Binding [TestSsh], Source={x:Static services:AppServices.Localizer}}" Command="{Binding TestConnectionCommand}"/>
                <Button Content="{Binding [Cancel], Source={x:Static services:AppServices.Localizer}}" MinWidth="92" Margin="0 0 8 0" ToolTip="{Binding [Cancel], Source={x:Static services:AppServices.Localizer}}" IsCancel="True"/>
                <Button Content="{Binding [Save], Source={x:Static services:AppServices.Localizer}}" MinWidth="110" Style="{StaticResource PrimaryButtonStyle}" ToolTip="{Binding [Save], Source={x:Static services:AppServices.Localizer}}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
